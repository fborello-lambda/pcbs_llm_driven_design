# Rust often needs a bit of an extra main task stack size compared to C (the default is 3K)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096

# Allow the longer request headers that phone browsers send
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# The firing callback runs in the esp_timer task; give it room for logging-free work.
CONFIG_ESP_TIMER_TASK_STACK_SIZE=4096

# Start the radio at low power: a full-power burst at Wi-Fi start can brown out weak
# USB chargers (the firmware also caps it at 8.5 dBm after start).
CONFIG_ESP_PHY_MAX_WIFI_TX_POWER=10
